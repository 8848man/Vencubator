rules_version = '2';

// SPEC-015 r0.4 §7 · ADR-006 — 피드백은 "새 문서 생성"만 허용한다. 읽기·수정·삭제는 모두 거부.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 그대로 붙여넣고 [게시]한다.
// 필드 목록·열거값·칩 ID는 prototype/feedback.mjs와 같아야 한다(prototype/tests/feedback-send.test.mjs가 대조).
service cloud.firestore {
  match /databases/{database}/documents {

    match /feedback/{docId} {
      allow read, update, delete: if false;
      allow create: if docId.size() <= 80 && validFeedback(request.resource.data);
    }

    // 그 밖의 모든 경로는 거부(테스트 모드 규칙을 대체).
    match /{document=**} {
      allow read, write: if false;
    }

    function fields() {
      return ['schema', 'kind', 'category', 'slot', 'occurrence', 'status', 'rating', 'helped', 'friction',
              'openType', 'text', 'view', 'concept', 'respondent', 'appVersion', 'env', 'clientTime'];
    }
    function chipIds() {
      return ['clear', 'split', 'start', 'many', 'mismatch', 'unsure',
              'concept', 'quiz', 'apply', 'short', 'long', 'hard', 'next',
              'organize', 'interpret', 'hint', 'input', 'value',
              'overview', 'options', 'record', 'evidence', 'burden'];
    }
    function optInt(v, lo, hi) { return v == null || (v is int && v >= lo && v <= hi); }
    function optIn(v, list) { return v == null || (v is string && v in list); }

    function validFeedback(d) {
      return d.keys().hasOnly(fields()) && d.keys().hasAll(fields())
        && d.schema == 1
        && d.kind in ['value', 'open']
        && optIn(d.category, ['idea', 'learning', 'evidence', 'decision'])
        && optInt(d.slot, 1, 100)
        && optInt(d.occurrence, 0, 100000)
        && optIn(d.status, ['answered', 'skipped', 'unanswered', 'missed'])
        && optInt(d.rating, 1, 5)
        && d.helped is list && d.helped.size() <= 4 && d.helped.hasOnly(chipIds())
        && d.friction is list && d.friction.size() <= 4 && d.friction.hasOnly(chipIds())
        && optIn(d.openType, ['helpful', 'friction', 'idea', 'bug'])
        && d.text is string && d.text.size() <= 1000
        && (d.view == null || (d.view is string && d.view.matches('^[a-z]{2,20}$')))
        && optIn(d.concept, ['customer', 'market', 'product', 'gtm', 'finance', 'operations', 'strategy'])
        && d.respondent is string && d.respondent.matches('^[0-9a-f]{16}$')
        && d.appVersion is string && d.appVersion.size() <= 20
        && d.env in ['production', 'qa']
        && d.clientTime is string && d.clientTime.size() <= 30
        && (d.kind == 'value'
              ? d.category != null && d.slot != null && d.occurrence != null && d.status != null && d.openType == null && d.text.size() <= 300
                && (d.status == 'answered' ? d.rating != null : d.rating == null)
              : d.openType != null && d.status == null && d.rating == null && d.slot == null && d.text.size() >= 5);
    }
  }
}
